Use System\FileSystem.pkg
Use DFUnit\Results\ResultCollector.pkg

Use DFUnit\Reporting\LineBasedReporting.pkg

Define XML_NEWLINE_REPLACE for "&#10;"

Function XmlEscapeAttribute Global String sValue Returns String
    Move (Replaces("&", sValue, "&amp;")) to sValue
    Move (Replaces("\n", sValue, XML_NEWLINE_REPLACE)) to sValue
    Move (Replaces("\r\n", sValue, XML_NEWLINE_REPLACE)) to sValue
    Move (Replaces(Character(10), sValue, XML_NEWLINE_REPLACE)) to sValue
    Move (Replaces('"', Replaces("'", Replaces('<', Replaces('>', sValue, '&gt;'), '&lt;'), '&apos;'), '&quot;')) to sValue
    
    Function_Return sValue
End_Function

Class cDFUnitJunitReporter is a cDFUnitResultCollector_Mixin
    
    Procedure Construct_Object
        Property String psOutputFileName ""
        
        Send Define_cDFUnitResultCollector_Mixin
    End_Procedure
    
    Function SupportsOutputToFile Returns Boolean
        Function_Return True
    End_Function
    
    {Visibility=Private}
    Procedure Write String sText
        String sFile
        Get psOutputFileName to sFile
        If (SizeOfString(sFile)) Begin
            Write sText
        End
        Else Begin
            Send DFUnit_ConsoleWrite sText
        End
    End_Procedure
    
    {Visibility=Private}
    Procedure WriteTest tDFUnitTestResult oTestResult
        String[] asMessages
        TimeSpan tsTook
        String sMessage sErrorExtenders sTime
        Integer iIterator iMessageIterator iMaxIndex iMaxMessageIndex
        
        Move (oTestResult.dtEnded - oTestResult.dtStarted) to tsTook
        If (SpanTotalSeconds(tsTook) = 0) Begin
            Move ('time="0.' + String(SpanTotalMilliseconds(tsTook)) + '"') to sTime
        End
        Else Begin
            Move ('time="' + String(SpanTotalSeconds(tsTook)) + "." + String(SpanMilliseconds(tsTook)) + '"') to sTime
        End

        Send Write (SFormat('<testcase name="%1" assertions="%2" %3>', TestName(oTestResult.hTest), oTestResult.ulFailedAssertions + oTestResult.ulSucceededAssertions, Replaces(",", sTime, ".")))        
        
        Move (SizeOfArray(oTestResult.aErrors) - 1) to iMaxIndex
        For iIterator from 0 to iMaxIndex
            If (oTestResult.aErrors[iIterator].bFatal) Begin
                Move "Fatal" to sErrorExtenders
            End
            If (oTestResult.aErrors[iIterator].bUser) Begin
                Move (If(Length(sErrorExtenders) = 0, "User", " User")) to sErrorExtenders
            End
            
            Move (SFormat("Unexpected %1 Error Occured:" + C_NewLine, sErrorExtenders)) to sMessage
            Move (Append(sMessage, (SFormat("Line: %1." + C_NewLine, oTestResult.aErrors[iIterator].iErrLine)))) to sMessage
            Move (Append(sMessage, (SFormat("Error Nr: %1." + C_NewLine, oTestResult.aErrors[iIterator].iErrorCode)))) to sMessage
            Move (Append(sMessage, "Error Message:" + C_NewLine)) to sMessage
            Move (Append(sMessage, ("'" + oTestResult.aErrors[iIterator].sErrText + "'." + C_NewLine))) to sMessage
            Move (Append(sMessage, "CallStack:" + C_NewLine)) to sMessage
            Move (Append(sMessage, oTestResult.aErrors[iIterator].sCallStack)) to sMessage
            
            Send Write (SFormat('<error message="%1"></error>', XmlEscapeAttribute(sMessage)))
        Loop
        
        Move (SizeOfArray(oTestResult.aFailedAssertions) - 1) to iMaxIndex
        For iIterator from 0 to iMaxIndex
            Move (oTestResult.aFailedAssertions[iMaxIndex].sAssertMessage + C_NewLine) to sMessage
            
            Move oTestResult.aFailedAssertions[iIterator].asMessages to asMessages
            Move (SizeOfArray(asMessages) - 1) to iMaxMessageIndex
            For iMessageIterator from 0 to iMaxMessageIndex
                Move (Append(sMessage, asMessages[iMessageIterator] + C_NewLine)) to sMessage
            Loop
            

            Send Write (SFormat('<failure message="%1"></failure>', XmlEscapeAttribute(sMessage)))
        Loop
        
        Send Write '</testcase>'
    End_Procedure
    
    {Visibility=Private}
    Procedure WriteFixture Handle hFixture
        String sFixtureName
        tDFUnitFixtureResult oFixtureResult
        Get ResultOfFixture hFixture to oFixtureResult
        
        Get FixtureName of hFixture to sFixtureName
        Send Write (SFormat('<testsuite name="%1" errors="%2" failures="%3">', XmlEscapeAttribute(sFixtureName), oFixtureResult.ulTotalErrors, oFixtureResult.ulTotalFailedAssertions))
        
        Integer iIterator iMaxIndex
        Move (SizeOfArray(oFixtureResult.ahChildFixtures) - 1) to iMaxIndex
        For iIterator from 0 to iMaxIndex
            Send WriteFixture oFixtureResult.ahChildFixtures[iIterator]
        Loop
        
        Move (SizeOfArray(oFixtureResult.aTestResults) - 1) to iMaxIndex
        For iIterator from 0 to iMaxIndex
            Send WriteTest oFixtureResult.aTestResults[iIterator]
        Loop
        
        Send Write '</testsuite>'
    End_Procedure

    {Visibility=Private}
    Procedure Finish Handle hEnv
        Forward Send Finish
        
        Boolean bOk
        
        Boolean bExists
        String sFileName
        Get psOutputFileName to sFileName
        
        If (SizeOfString(sFileName)) Begin
            File_Exist sFileName to bExists
            If (bExists) Begin
                Erase_File sFileName
            End
            
            Send DFUnit_ConsoleWriteLn C_DFUNIT_LINEBASED_LINE
            Send DFUnit_ConsoleWriteLn (SFormat("[DFUnit] junit (XML): %1", sFileName))
            
            Direct_Output sFileName
            Move (not(SeqEof)) to bOk
            If (SeqEof) Begin
                Error 871 "Failed to open the junit file."
            End
        End
        
        Send Write '<?xml version="1.0" encoding="UTF-8"?>'
        Send Write '<testsuites>'
        
        Send WriteFixture ghoTestApplication
        
        Send Write '</testsuites>'
        If (bOk) Close_Output
    End_Procedure
    
End_Class
