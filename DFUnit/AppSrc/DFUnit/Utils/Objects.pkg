Use UI

{ Visibility=Private }
Function DFUnit_GetObjectNameWithNoParent Global Handle hObject Returns String
    String sName
    Integer iPos
    
    Get Name of hObject to sName
    Move (Pos(".", sName)) to iPos
    While (iPos > 0)
        Move (Mid(sName, Length(sName) - iPos, iPos + 1)) to sName
        Move (Pos(".", sName)) to iPos
    Loop
    
    Function_Return sName
End_Function    

{Visibility=Private}
Function DFUnit_NullableNameOfObject Global Handle hObject Returns String
    String sObjectName
    
    Get Name of hObject to sObjectName
    
    Function_Return sObjectName
End_Function