#IFNDEF C_RuntimePlaformId_Unknown
Enum_List
    Define C_RuntimePlaformId_Unknown for 0
    Define C_RuntimePlaformId_Windows
    Define C_RuntimePlaformId_MacOS
    Define C_RuntimePlaformId_Linux
    Define C_RuntimePlaformId_Unix
    Define C_RuntimePlaformId_WASM
    Define C_RuntimePlaformId_WASI
